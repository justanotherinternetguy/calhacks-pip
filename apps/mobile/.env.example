EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional: Google Maps key for Android map tiles
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: Claude API key for the monitor's AI analysis panel (preferred over OpenRouter when set).
# It ships inside the web bundle: use a dedicated key with a low monthly spend limit (Claude Console).
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-haiku-5-5)
EXPO_PUBLIC_ANTHROPIC_MODEL=
# Optional: OpenRouter key for the monitor's AI analysis panel, used as the fallback (free models; https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: override the model (default nvidia/nemotron-3.5-lightning:free)
OPENROUTER_MODEL=
